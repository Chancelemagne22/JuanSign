# JuanSign front-end — environment template
# Copy to .env.local and fill values. NEVER commit .env.local.
# Public (NEXT_PUBLIC_) vars are inlined into client JS — NEVER put secrets there.

# ── Public (safe for client) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_VERSION=v1.0
NEXT_PUBLIC_ENV=Development
NEXT_PUBLIC_LAST_UPDATE=
# I-8: demo override — set to "true" locally to unlock all lesson chapters
# without completing prerequisites (never set in production).
# NEXT_PUBLIC_ALLOW_ALL_UNLOCKED=true

# ── Server-only (no NEXT_PUBLIC_ prefix) ──
# Required by API routes + lib/supabase-server.ts. Keep out of git.
# Supabase now issues Secret keys (sb_secret_...) instead of legacy service_role.
# Set SUPABASE_SECRET_KEY (preferred); SUPABASE_SERVICE_ROLE_KEY still works as fallback.
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=  (legacy fallback — remove once migrated)
MODAL_ENDPOINT_URL=
# Legacy: NEXT_PUBLIC_SUPABASE_JWT_SECRET is DEPRECATED — do not set it.
# If you need JWT verification server-side, use SUPABASE_JWT_SECRET (no prefix).
# SUPABASE_JWT_SECRET=

# ── Admin bootstrap (local dev only) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_AUTH_SECRET=
ADMIN_AVATAR_URL=
